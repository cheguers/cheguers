{
  "name": "cheguersdb-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "oxlint",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest run",
    "bench": "pnpm --filter @cheguers/benchmark bench"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.81.0",
    "@types/node": "^24.10.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
